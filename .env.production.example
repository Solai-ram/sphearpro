# =============================================================================
# SPHEAR — demo / staging production template (sphearpro.tech)
# Copy to `.env.production` on the VPS only. NEVER commit real secrets.
#
# Mode: test & demo — Razorpay TEST keys (rzp_test_*) are intentional.
# Switch to rzp_live_* only when charging real customers.
# =============================================================================

NODE_ENV=production

# Public URLs — point DNS at your VPS (domain is currently Hostinger-parked until DNS is cut over)
# Prefer HTTPS once Let's Encrypt is set up; include both schemes in CORS during transition.
API_URL=https://api.sphearpro.tech
FRONTEND_URL=https://sphearpro.tech
ADMIN_URL=https://sphearpro.tech
CORS_ORIGIN=https://sphearpro.tech,http://sphearpro.tech,https://www.sphearpro.tech,http://www.sphearpro.tech,https://api.sphearpro.tech

# -----------------------------------------------------------------------------
# Postgres (internal Docker DNS — do not publish 5432)
# -----------------------------------------------------------------------------
POSTGRES_USER=hislite
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=hislite

# -----------------------------------------------------------------------------
# Redis (requirepass)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# JWT (openssl rand -base64 48)
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_JWT_ACCESS_MIN_32_CHARS________________
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_MIN_32_CHARS_______________
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# MinIO (private — no public ports)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=hislite_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
S3_BUCKET=hislite-documents
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# SMTP (real provider for demo emails — Mailpit only for local)
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@sphearpro.tech
MAIL_SECURE=false

# -----------------------------------------------------------------------------
# Razorpay TEST mode (demo OK) — Dashboard → Test Mode
# Webhook: https://api.sphearpro.tech/api/v1/webhooks/razorpay
# Events: subscription.authenticated, subscription.activated, subscription.charged,
#         subscription.pending, subscription.halted, subscription.cancelled,
#         subscription.completed, payment.failed
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_TYdpm8Pgv7Td5l
RAZORPAY_KEY_SECRET=REPLACE_WITH_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_FROM_DASHBOARD_WEBHOOK
RAZORPAY_MONTHLY_PLAN_ID=plan_TYeFsYg2ghqgZh
RAZORPAY_YEARLY_PLAN_ID=plan_TYeZQ1svuDpVLO
RAZORPAY_PLAN_ID=plan_TYeFsYg2ghqgZh
RAZORPAY_PLAN_ID_YEARLY=plan_TYeZQ1svuDpVLO
RAZORPAY_TRIAL_DAYS=7
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_YEARLY=10
ALLOW_MANUAL_SUBSCRIPTION_ACTIVATE=false
SUBSCRIPTION_ENFORCE=true
SUBSCRIPTION_GRACE_DAYS=5
SUBSCRIPTION_CURRENCY=INR
SAAS_DEFAULT_PLAN_CODE=STANDARD

# -----------------------------------------------------------------------------
# Optional AI / WhatsApp (server only)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
OPENAPI_ENABLED=false
LOG_LEVEL=info
SENTRY_DSN=

# Platform bootstrap (change after first seed)
PLATFORM_ADMIN_EMAIL=platform@sphearpro.tech
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_PLATFORM_PASSWORD

# -----------------------------------------------------------------------------
# Off-VPS backups (recommended even for demo)
# -----------------------------------------------------------------------------
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=sphear-offsite-backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
BACKUP_CRON=0 2 * * *

ENV_FILE=.env.production
