# Prisma Studio for database inspection
FROM node:20-alpine

WORKDIR /app

# Copy prisma schema and package files
COPY prisma ./prisma
COPY package*.json ./

# Install dependencies
RUN npm ci

# Generate Prisma client
RUN npx prisma generate

EXPOSE 5555

CMD ["npx", "prisma", "studio", "--hostname", "0.0.0.0", "--port", "5555"]