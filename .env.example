# =============================================================================
# HIS-Lite Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://hislite:hislite_dev_password@localhost:5432/hislite?schema=public
POSTGRES_USER=hislite
POSTGRES_PASSWORD=hislite_dev_password
POSTGRES_DB=hislite
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis (BullMQ, caching, sessions)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_chars_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Password Hashing (Argon2)
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Rate Limiting (Throttler)
# -----------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Set true only while running load-tests/ (local k6 shares one IP)
DISABLE_THROTTLE=false

# -----------------------------------------------------------------------------
# S3-Compatible Storage (MinIO for dev, AWS S3 for prod)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=hislite-documents
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Email (Mailpit for dev, SMTP for prod)
# -----------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@hislite.local
# MAIL_SECURE=true

# Subscription scheduled jobs (Phase 10) — require Redis
# SUBSCRIPTION_JOBS_DISABLED=true
# SUBSCRIPTION_RECONCILE_APPLY=true

# -----------------------------------------------------------------------------
# Admin User (created by seed script)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@hislite.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator

# -----------------------------------------------------------------------------
# WhatsApp Provider (for Phase 7)
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=twilio  # or "gupshup", "meta"
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_API_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# AI Providers
# -----------------------------------------------------------------------------
# Google Gemini (summarization / note drafts — replaces OpenRouter)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ElevenLabs Speech-to-Text (replaces Sarvam)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Public URLs (production SaaS — leave as localhost in development)
# -----------------------------------------------------------------------------
# API_URL=https://api.hislite.in
# FRONTEND_URL=https://app.hislite.in
# ADMIN_URL=https://admin.hislite.in

# -----------------------------------------------------------------------------
# SaaS subscription / Razorpay (see docs/SAAS-DECISIONS.md)
# Secrets must NEVER be sent to the React app.
# -----------------------------------------------------------------------------
# Test keys: rzp_test_… / matching secret (Dashboard → API Keys).
# Live keys: rzp_live_… — only on production VPS. Mode is inferred from key id prefix.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay Dashboard → Subscriptions → Plans:
# Preferred env names (checked first by API):
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=
# Legacy fallbacks:
# - Monthly: ₹1,800 (180000 paise) → RAZORPAY_PLAN_ID
# - Yearly: ₹18,000 (1800000 paise) → RAZORPAY_PLAN_ID_YEARLY
# Required for POST /subscription/checkout.
RAZORPAY_PLAN_ID=
RAZORPAY_PLAN_ID_YEARLY=

# Checkout trial length (Razorpay subscription start_at). Default 7.
RAZORPAY_TRIAL_DAYS=7

# Billing cycles to create on provider (default 120 ≈ 10 years monthly)
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT_YEARLY=10

# Process webhooks inline (skip BullMQ) — useful for local/dev debugging
# RAZORPAY_WEBHOOK_SYNC=true

# Enforce SubscriptionGuard / FeatureGuard on authenticated HIS APIs (default on)
# Set false only for emergency local bypass
SUBSCRIPTION_ENFORCE=true

# Production: keep false. Manual activate blocked when NODE_ENV=production unless true.
ALLOW_MANUAL_SUBSCRIPTION_ACTIVATE=false

# Grace period after payment failure before EXPIRED (days)
SUBSCRIPTION_GRACE_DAYS=5

# Money: amounts in DB are integer paise; currency code for SaaS invoices
SUBSCRIPTION_CURRENCY=INR

# Primary commercial plan code (seed / pricing highlight)
SAAS_DEFAULT_PLAN_CODE=STANDARD

# Optional platform super-admin bootstrap (Phase 9)
PLATFORM_ADMIN_EMAIL=platform@hislite.local
PLATFORM_ADMIN_PASSWORD=Platform@12345

# -----------------------------------------------------------------------------
# Off-VPS backups (Phase 11) — separate from clinic document MinIO
# -----------------------------------------------------------------------------
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=