    "@hookform/resolvers": "^5.8.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "axios": "^1.6.7",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.31.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^6.22.0",
    "zod": "^3.25.76"
